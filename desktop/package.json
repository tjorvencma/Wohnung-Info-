{
  "name": "wohnungsplaner",
  "version": "1.0.0",
  "description": "Wohnungsplaner: Umzug 2027 als Windows-App",
  "author": "Wohnungsplaner",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.wohnungsplaner.app",
    "productName": "Wohnungsplaner",
    "copyright": "Wohnungsplaner",
    "directories": { "output": "dist" },
    "files": ["main.js", "offline.html", "build/icon.png"],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Wohnungsplaner",
      "artifactName": "Wohnungsplaner-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Wohnungsplaner-Portable.${ext}"
    }
  }
}
